---
import type { Anime } from "../../lib/types";
interface Props {
	anime: Anime;
	rank?: number;
	compact?: boolean;
}
const { anime, rank, compact = false } = Astro.props;
const displayTitle =
	anime.title.english || anime.title.romaji || anime.title.native || "Untitled";
---
<article class="group relative min-w-0">
  <a href={`/anime/${anime.id}/${anime.slug}`} class="block rounded-lg focus-visible:ring-2 focus-visible:ring-terracotta-500">
    <div class={`relative overflow-hidden rounded-lg border border-parchment-200 bg-parchment-100 shadow-card ${compact ? 'aspect-[3/4]' : 'aspect-[3/4]'}`}>
      <img src={anime.coverImage.extraLarge || anime.coverImage.large} alt={`Cover art for ${displayTitle}`} loading="lazy" decoding="async" width="460" height="613" class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" />
      {rank && <span class="absolute left-2.5 top-2.5 flex h-8 min-w-8 items-center justify-center rounded-full bg-evergreen-900 px-2 text-sm font-bold text-white shadow-sm">{rank}</span>}
      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-3 pt-10 text-white">
        <div class="flex flex-wrap gap-x-2 text-[11px] font-semibold text-white/85">{anime.score && <span>{anime.score}%</span>}{anime.format && <span>{anime.format}</span>}</div>
      </div>
    </div>
    <h3 class="mt-3 line-clamp-2 min-h-[2.75rem] font-serif text-base font-bold leading-snug text-evergreen-950 group-hover:text-terracotta-700">{displayTitle}</h3>
    <div class="mt-2 flex flex-wrap gap-1.5">{anime.genres.slice(0, 2).map((genre) => <span class="rounded-sm bg-parchment-100 px-2 py-0.5 text-[11px] font-semibold text-parchment-700">{genre}</span>)}</div>
  </a>
</article>
