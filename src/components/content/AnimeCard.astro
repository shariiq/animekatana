---
import type { Anime } from '../../lib/types';

interface Props {
  anime: Anime;
  rank?: number;
}

const { anime, rank } = Astro.props;
const displayTitle = anime.title.english || anime.title.romaji || anime.title.native || 'Untitled';
---

<article class="anime-card group">
  <a href={`/anime/${anime.id}/${anime.slug}`} class="block focus:outline-none">
    <div class="anime-card-image">
      <img
        src={anime.coverImage.extraLarge || anime.coverImage.large}
        alt={`Cover art for ${displayTitle}`}
        loading="lazy"
        decoding="async"
        class="anime-card-img"
      />
      {rank && (
        <div class="absolute left-3 top-3 flex h-8 min-w-8 items-center justify-center rounded-full bg-evergreen-900 px-2 text-sm font-bold text-white shadow-md">
          {rank}
        </div>
      )}
      <div class="anime-card-overlay">
        <div class="flex items-center gap-2 text-xs font-medium text-white/90">
          {anime.score && <span class="bg-black/40 px-1.5 py-0.5 rounded">{anime.score}% Match</span>}
          {anime.format && <><span class="bg-black/40 px-1.5 py-0.5 rounded">{anime.format}</span></>}
        </div>
      </div>
    </div>
    <div class="anime-card-body">
      <h3 class="anime-card-title line-clamp-2 min-h-[2.75rem]">
        {displayTitle}
      </h3>
      <div class="anime-card-meta">
        {anime.genres.slice(0, 2).map((genre) => (
          <span class="rounded-full bg-parchment-100 px-2 py-0.5 text-[10px] font-medium text-gray-600">{genre}</span>
        ))}
      </div>
    </div>
  </a>
</article>