---
import type { Anime } from '../../lib/types';
import AnimeCard from './AnimeCard.astro';

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  anime: Anime[];
  viewAllHref?: string;
  ranked?: boolean;
}

const { title, eyebrow, description, anime, viewAllHref, ranked = false } = Astro.props;
---

<section class="py-12 sm:py-16">
  <div class="section-header">
    <div>
      {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
      <h2 class="section-title">{title}</h2>
      {description && <p class="body-sm mt-2">{description}</p>}
    </div>
    {viewAllHref && (
      <a href={viewAllHref} class="section-link">
        View all
        <span aria-hidden="true">→</span>
      </a>
    )}
  </div>

  {anime.length > 0 ? (
    <div class="anime-grid">
      {anime.map((item, index) => (
        <AnimeCard anime={item} rank={ranked ? index + 1 : undefined} />
      ))}
    </div>
  ) : (
    <div class="state-empty">
      <p class="body-sm">No anime available right now.</p>
    </div>
  )}
</section>