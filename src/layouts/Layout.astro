---
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = 'AnimeKatana — Discover Your Next Story',
  description = 'A warm, editorial anime discovery and watch destination powered by AniList.',
  image = '/og-image.jpg',
  canonicalUrl = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-parchment-50 text-gray-900">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:px-4 focus:py-2">
      Skip to main content
    </a>

    <header class="sticky top-0 z-40 border-b border-parchment-200 bg-parchment-50/95 backdrop-blur-sm">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <a href="/" class="font-serif text-2xl font-bold text-evergreen-900 hover:text-terracotta-700">
          AnimeKatana
        </a>

        <nav aria-label="Primary navigation" class="hidden items-center gap-6 md:flex">
          <a href="/browse" class="text-sm font-medium text-gray-700 hover:text-evergreen-700">Browse</a>
          <a href="/season" class="text-sm font-medium text-gray-700 hover:text-evergreen-700">Seasonal</a>
          <a href="/schedule" class="text-sm font-medium text-gray-700 hover:text-evergreen-700">Schedule</a>
          <a href="/rankings" class="text-sm font-medium text-gray-700 hover:text-evergreen-700">Rankings</a>
        </nav>

        <div class="flex items-center gap-3">
          <a href="/search" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-800 hover:border-evergreen-500 hover:text-evergreen-700 focus:outline-none focus:ring-2 focus:ring-evergreen-500 focus:ring-offset-2">
            Search
          </a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="mt-20 border-t border-parchment-200 bg-parchment-100">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid gap-8 md:grid-cols-3">
          <div>
            <h2 class="font-serif text-xl font-bold text-evergreen-900">AnimeKatana</h2>
            <p class="mt-3 text-sm text-gray-600">A crafted anime destination, powered by AniList.</p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">Explore</h3>
            <ul class="mt-3 space-y-2 text-sm text-gray-600">
              <li><a href="/browse" class="hover:text-evergreen-700">Browse Anime</a></li>
              <li><a href="/season" class="hover:text-evergreen-700">Seasonal Anime</a></li>
              <li><a href="/schedule" class="hover:text-evergreen-700">Airing Schedule</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">About</h3>
            <p class="mt-3 text-sm text-gray-600">Catalogue data from AniList. Playback provided by AniSource.</p>
          </div>
        </div>
        <div class="mt-10 border-t border-parchment-200 pt-6 text-center text-xs text-gray-500">
          © {new Date().getFullYear()} AnimeKatana. This site does not host video content.
        </div>
      </div>
    </footer>
  </body>
</html>