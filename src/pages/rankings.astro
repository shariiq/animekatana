---
import AnimeSection from "../components/content/AnimeSection.astro";
import Layout from "../layouts/Layout.astro";
import { getCatalogue } from "../lib/anilist/client";
import { parseRankingsQuery, rankingsHref } from "../lib/catalogue-query";

const query = parseRankingsQuery(Astro.url.searchParams);
let data: Awaited<ReturnType<typeof getCatalogue>> | null = null;
let error: string | null = null;
try {
	data = await getCatalogue({ page: query.page, sort: [query.type] });
} catch (cause) {
	error =
		cause instanceof Error
			? cause.message
			: "The rankings could not be loaded.";
}

const rankingTypes = [
	{ id: "POPULARITY_DESC", label: "Most Popular" },
	{ id: "SCORE_DESC", label: "Highest Rated" },
	{ id: "FAVOURITES_DESC", label: "Most Favourites" },
] as const;
---

<Layout title="Rankings — AnimeKatana">
  <section class="border-b border-parchment-200 bg-parchment-100 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="font-serif text-4xl font-bold text-evergreen-950 sm:text-5xl">Rankings</h1>
      <p class="mt-4 max-w-2xl text-lg text-gray-700">Explore the definitive lists of the most beloved and highest-rated anime of all time.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {rankingTypes.map((ranking) => (
          <a href={rankingsHref(query, { type: ranking.id, page: 1 })} class={`rounded-full px-4 py-2 text-sm font-bold transition ${query.type === ranking.id ? 'bg-evergreen-800 text-white' : 'border border-parchment-300 bg-white text-gray-600 hover:bg-parchment-100'}`}>
            {ranking.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    {error ? (
      <div class="rounded-lg border border-terracotta-200 bg-terracotta-50 p-6 text-terracotta-800">{error}</div>
    ) : data && data.items.length > 0 ? (
      <AnimeSection title={`Ranked by ${rankingTypes.find((ranking) => ranking.id === query.type)?.label ?? 'Popularity'}`} anime={data.items} ranked rankOffset={(query.page - 1) * 24} />
    ) : (
      <div class="py-24 text-center text-gray-600">No anime found for this ranking.</div>
    )}

    {data?.hasNext && (
      <div class="mt-12 flex justify-center gap-4">
        <a href={rankingsHref(query, { page: Math.max(1, query.page - 1) })} class={`rounded-md border border-gray-300 bg-white px-6 py-2 text-sm font-medium ${query.page === 1 ? 'pointer-events-none opacity-50' : 'hover:bg-gray-50'}`}>Previous</a>
        <a href={rankingsHref(query, { page: query.page + 1 })} class="rounded-md border border-gray-300 bg-white px-6 py-2 text-sm font-medium hover:bg-gray-50">Next Page</a>
      </div>
    )}
  </div>
</Layout>
