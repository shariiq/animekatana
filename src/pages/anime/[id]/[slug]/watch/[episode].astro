---
import Layout from "../../../../../layouts/Layout.astro";
import WatchPlayer from "../../../../../components/islands/WatchPlayer";
import { getAnime } from "../../../../../lib/anilist/client";

const animeId = Number(Astro.params.id);
const requestedEpisode = Number(Astro.params.episode);
const data =
	Number.isInteger(animeId) && animeId > 0
		? await getAnime(animeId).catch(() => null)
		: null;
if (!data) return Astro.redirect("/404");
const { anime } = data;
const episodeNumber =
	Number.isInteger(requestedEpisode) && requestedEpisode > 0
		? requestedEpisode
		: 1;
---

<Layout title={`Watch ${anime.title.english || anime.title.romaji} — AnimeKatana`} description={`Watch ${anime.title.english || anime.title.romaji} episode ${episodeNumber}.`} image={anime.coverImage.extraLarge}>
  <div class="page-shell py-8 sm:py-10">
    <div class="mb-8 border-b border-parchment-200 pb-5"><a href={`/anime/${anime.id}/${anime.slug}`} class="ink-link text-sm">← Back to anime guide</a><p class="eyebrow mt-5">Now watching</p><h1 class="display-title mt-1 text-3xl">{anime.title.english || anime.title.romaji}</h1></div>
    <WatchPlayer animeId={anime.id} episodeNumber={episodeNumber} />
  </div>
</Layout>
