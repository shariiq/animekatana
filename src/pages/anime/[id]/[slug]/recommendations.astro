---
import Layout from '../../../../layouts/Layout.astro';
import { getAnime } from '../../../../lib/anilist/client';

const { id } = Astro.params;
const animeId = parseInt(id!);

let data: Awaited<ReturnType<typeof getAnime>> | null = null;
try {
  data = await getAnime(animeId);
} catch {
}

if (!data) {
  return Astro.redirect('/404');
}

const { anime, raw } = data;
---

<Layout title={`${anime.title.english || anime.title.romaji} — Recommendations — AnimeKatana`}>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="space-y-8">
      <div class="flex items-center justify-between space-x-6">
        <a href={`/anime/${anime.id}/${anime.slug}`} class="text-sm font-medium text-gray-600 hover:text-evergreen-700">
          ← Back to Overview
        </a>
        <h1 class="font-serif text-3xl font-bold text-evergreen-950">
          {anime.title.english || anime.title.romaji}
        </h1>
      </div>

      <section class="space-y-6">
        <h2 class="font-serif text-2xl font-bold text-evergreen-900">Recommendations</h2>
        {raw.recommendations?.nodes?.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {raw.recommendations.nodes.map(({ mediaRecommendation: node }: { mediaRecommendation: any }) => (
              <div class="group relative rounded-lg border border-parchment-200 bg-white p-4 shadow-sm hover:shadow-md transition">
                <div class="flex gap-4">
                  <img src={node.coverImage.large} class="h-20 w-12 object-cover rounded" alt="" />
                  <div>
                    <p class="text-xs font-bold uppercase text-terracotta-600">Recommended</p>
                    <h4 class="font-serif text-sm font-bold text-gray-900 line-clamp-1">{node.title.romaji}</h4>
                    <a href={`/anime/${node.id}/${node.slug}`} class="text-xs text-evergreen-700 hover:underline">View details →</a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="py-12 text-center text-gray-600">No recommendations available.</div>
        )}
      </section>
    </div>
  </div>
</Layout>