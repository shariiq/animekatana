---
import Layout from "../../../../layouts/Layout.astro";
import { getAnime } from "../../../../lib/anilist/client";

const { id } = Astro.params;
const animeId = parseInt(id!);

let data: Awaited<ReturnType<typeof getAnime>> | null = null;
try {
	data = await getAnime(animeId);
} catch {}

if (!data) {
	return Astro.redirect("/404");
}

const { anime, raw } = data;
const characters = raw.characters?.edges ?? [];
---

<Layout title={`${anime.title.english || anime.title.romaji} — Characters — AnimeKatana`}>
  <div class="page-shell py-10 sm:py-12">
    <div class="space-y-8">
      <div class="flex items-center justify-between space-x-6">
        <a href={`/anime/${anime.id}/${anime.slug}`} class="text-sm font-medium text-gray-600 hover:text-evergreen-700">
          ← Back to Overview
        </a>
        <h1 class="font-serif text-3xl font-bold text-evergreen-950">
          {anime.title.english || anime.title.romaji}
        </h1>
      </div>

      <section class="space-y-6">
        <h2 class="font-serif text-2xl font-bold text-evergreen-900">Characters & Voice Actors</h2>
        {characters.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {characters.map(({ role, node, voiceActors }) => (
              <div class="group relative rounded-lg border border-parchment-200 bg-white p-4 shadow-sm hover:shadow-md transition">
                <div class="flex gap-4">
                  <img src={node.image.large} class="h-24 w-16 object-cover rounded" alt="" />
                  <div class="space-y-2">
                    <p class="text-xs font-bold uppercase text-terracotta-600">{role}</p>
                    <h4 class="font-serif text-sm font-bold text-gray-900 line-clamp-2">{node.name.full}</h4>
                    {node.name.native && <p class="mt-1 text-xs text-gray-500 italic">{node.name.native}</p>}
                    {voiceActors.length > 0 && (
                      <div class="mt-2 space-y-1">
                        <p class="text-xs font-semibold text-gray-600">Voice Actor (JP)</p>
                        {voiceActors.map((va) => (
                          <div class="flex items-center gap-2">
                            <img src={va.image?.large ?? ''} class="h-8 w-8 rounded" alt="" />
                            <span class="text-sm">{va.name.full}</span>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="py-12 text-center text-gray-600">No character data available.</div>
        )}
      </section>
    </div>
  </div>
</Layout>