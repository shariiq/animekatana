---
import Layout from "../../../../layouts/Layout.astro";
import { getAnime } from "../../../../lib/anilist/client";

const { id } = Astro.params;
const animeId = parseInt(id!);

let data: Awaited<ReturnType<typeof getAnime>> | null = null;
try {
	data = await getAnime(animeId);
} catch {}

if (!data) {
	return Astro.redirect("/404");
}

const { anime, raw } = data;
const staff = raw.staff?.edges ?? [];
---

<Layout title={`${anime.title.english || anime.title.romaji} — Staff — AnimeKatana`}>
  <div class="page-shell py-10 sm:py-12">
    <div class="space-y-8">
      <div class="flex items-center justify-between space-x-6">
        <a href={`/anime/${anime.id}/${anime.slug}`} class="text-sm font-medium text-gray-600 hover:text-evergreen-700">
          ← Back to Overview
        </a>
        <h1 class="font-serif text-3xl font-bold text-evergreen-950">
          {anime.title.english || anime.title.romaji}
        </h1>
      </div>

      <section class="space-y-6">
        <h2 class="font-serif text-2xl font-bold text-evergreen-900">Staff</h2>
        {staff.length > 0 ? (
          <div class="space-y-4">
            {staff.map(({ role, node }) => (
              <div class="flex items-start gap-4">
                <img src={node.image.large} class="h-12 w-8 object-cover rounded" alt="" />
                <div class="space-y-1">
                  <p class="text-xs font-semibold text-gray-600">{role}</p>
                  <h4 class="font-serif text-sm font-bold text-gray-900">{node.name.full}</h4>
                  {node.name.native && <p class="mt-1 text-xs text-gray-500 italic">{node.name.native}</p>}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="py-8 text-center text-gray-600">No staff data available.</div>
        )}
      </section>
    </div>
  </div>
</Layout>