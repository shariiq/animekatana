---
import Layout from "../../../layouts/Layout.astro";
import { getAnime, slugify } from "../../../lib/anilist/client";
const animeId = parseInt(Astro.params.id!);
const data = await getAnime(animeId).catch(() => null);
if (!data) return Astro.redirect("/404");
const { anime, raw } = data;
const title = anime.title.english || anime.title.romaji;
const tabs = [
	{ label: "Overview", href: "" },
	{ label: "Characters", href: "/characters" },
	{ label: "Staff", href: "/staff" },
	{ label: "Recommendations", href: "/recommendations" },
	{ label: "Statistics", href: "/stats" },
	...(anime.trailer ? [{ label: "Trailers", href: "/trailers" }] : []),
];
---
<Layout title={`${title} — AnimeKatana`} description={anime.description || undefined} image={anime.coverImage.extraLarge}><section class="relative overflow-hidden border-b border-parchment-200 bg-evergreen-950 text-white">{anime.bannerImage && <img src={anime.bannerImage} alt="" width="1600" height="600" class="absolute inset-0 h-full w-full object-cover opacity-25" />}<div class="absolute inset-0 bg-gradient-to-r from-evergreen-950 via-evergreen-950/90 to-evergreen-950/50"></div><div class="page-shell relative grid gap-7 py-10 sm:grid-cols-[12rem_1fr] sm:items-end sm:py-14"><img src={anime.coverImage.extraLarge} alt={`Cover art for ${title}`} width="460" height="613" class="aspect-[3/4] w-36 rounded-lg object-cover shadow-lift sm:w-full" /><div><p class="text-xs font-bold uppercase tracking-[.18em] text-parchment-300">{anime.format} · {anime.status}</p><h1 class="mt-3 max-w-4xl font-serif text-4xl font-bold leading-tight sm:text-6xl">{title}</h1>{anime.title.native && <p class="mt-2 text-lg text-parchment-300">{anime.title.native}</p>}<div class="mt-5 flex flex-wrap gap-2">{anime.genres.map((genre: string) => <span class="rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-semibold">{genre}</span>)}</div><a href={`/anime/${anime.id}/${anime.slug}/watch/1`} class="button-primary mt-7 !bg-terracotta-600 hover:!bg-terracotta-500">Start watching</a></div></div></section><div class="page-shell"><nav aria-label="Anime sections" class="-mx-4 flex overflow-x-auto border-b border-parchment-200 px-4 sm:mx-0 sm:px-0">{tabs.map((tab) => <a href={`/anime/${anime.id}/${anime.slug}${tab.href}`} aria-current={tab.href === '' ? 'page' : undefined} class={`flex min-h-12 shrink-0 items-center border-b-2 px-4 text-sm font-bold ${tab.href === '' ? 'border-terracotta-600 text-evergreen-900' : 'border-transparent text-parchment-600 hover:text-evergreen-900'}`}>{tab.label}</a>)}</nav><div class="grid gap-10 py-10 lg:grid-cols-[1fr_18rem]"><main class="space-y-10"><section><p class="eyebrow">The story</p><h2 class="display-title mt-2 text-3xl">Synopsis</h2><p class="mt-5 max-w-3xl text-base leading-8 text-parchment-700 sm:text-lg">{anime.description || 'No synopsis available.'}</p></section><section><h2 class="display-title text-2xl">Related works</h2><div class="mt-5 grid gap-3 sm:grid-cols-2">{raw.relations?.edges?.length ? raw.relations.edges.map(({ node, relationType }) => <a href={`/anime/${node.id}/${slugify(node.title.english || node.title.romaji || node.title.native || `anime-${node.id}`)}`} class="paper-card flex min-h-28 gap-4 p-3 hover:border-evergreen-400"><img src={node.coverImage.large} alt="" width="80" height="112" class="aspect-[5/7] w-16 rounded object-cover" /><div class="py-1"><p class="eyebrow">{relationType}</p><h3 class="mt-2 line-clamp-2 font-serif font-bold text-evergreen-950">{node.title.romaji}</h3></div></a>) : <p class="text-parchment-600">No related works found.</p>}</div></section></main><aside class="paper-card h-fit p-5"><h2 class="font-serif text-xl font-bold text-evergreen-950">Quick facts</h2><dl class="mt-5 divide-y divide-parchment-200 text-sm">{[['Status', anime.status], ['Format', anime.format], ['Episodes', anime.episodes ?? '?'], ['Score', anime.score ? `${anime.score}%` : '—']].map(([label, value]) => <div class="flex justify-between gap-4 py-3"><dt class="text-parchment-600">{label}</dt><dd class="text-right font-bold text-evergreen-950">{value}</dd></div>)}</dl><div class="mt-6"><h3 class="text-xs font-bold uppercase tracking-wider text-parchment-600">Studios</h3><p class="mt-2 text-sm leading-relaxed">{anime.studios.join(', ') || 'Unknown'}</p></div></aside></div></div></Layout>
