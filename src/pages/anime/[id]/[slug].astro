---
import Layout from '../../../layouts/Layout.astro';
import { getAnime } from '../../../lib/anilist/client';

const { id } = Astro.params;
const animeId = parseInt(id!);

let data: Awaited<ReturnType<typeof getAnime>> | null = null;
try {
  data = await getAnime(animeId);
} catch {
}

if (!data) {
  return Astro.redirect('/404');
}

const { anime, raw } = data;
---

<Layout title={`${anime.title.english || anime.title.romaji} — AnimeKatana`}>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[320px_1fr]">
      <aside class="space-y-6">
        <div class="relative overflow-hidden rounded-xl bg-parchment-200 shadow-md">
          <img src={anime.coverImage.extraLarge} alt={anime.title.romaji} class="h-full w-full object-cover" />
        </div>

        <div class="rounded-xl border border-parchment-200 bg-white p-6 shadow-sm space-y-4">
          <h3 class="font-serif text-lg font-bold text-evergreen-900">Quick Facts</h3>
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-gray-500">Status</dt>
              <dd class="font-medium">{anime.status}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Format</dt>
              <dd class="font-medium">{anime.format}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Episodes</dt>
              <dd class="font-medium">{anime.episodes ?? '?'}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Score</dt>
              <dd class="font-medium text-terracotta-700">{anime.score ?? '—'}%</dd>
            </div>
          </dl>
          <a href={`/anime/${anime.id}/${anime.slug}/watch/1`}
             class="block w-full rounded-md bg-evergreen-800 py-3 text-center font-bold text-white hover:bg-evergreen-700 shadow-sm transition">
            Start Watching
          </a>
        </div>
      </aside>

      <main class="space-y-12">
        <header>
          <h1 class="font-serif text-4xl font-bold leading-tight text-evergreen-950 sm:text-6xl">
            {anime.title.english || anime.title.romaji}
          </h1>
          <p class="mt-3 text-xl text-gray-600 font-medium">{anime.title.native}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {anime.genres.map((g: string) => <span class="rounded-full bg-parchment-100 px-3 py-1 text-xs font-semibold text-gray-600">{g}</span>)}
          </div>
        </header>

        <nav class="flex flex-wrap gap-1 border-b border-parchment-200 text-sm">
        <a href="#overview" aria-current="page" class="rounded-t-md border-b-2 border-evergreen-800 px-4 py-3 font-semibold text-evergreen-800 hover:border-evergreen-300 hover:text-evergreen-800">Overview</a>
        <a href={`/anime/${anime.id}/${anime.slug}/characters`} class="rounded-t-md border-b-2 border-transparent px-4 py-3 font-semibold text-gray-500 hover:border-evergreen-300 hover:text-evergreen-800">Characters</a>
        <a href={`/anime/${anime.id}/${anime.slug}/staff`} class="rounded-t-md border-b-2 border-transparent px-4 py-3 font-semibold text-gray-500 hover:border-evergreen-300 hover:text-evergreen-800">Staff</a>
        <a href={`/anime/${anime.id}/${anime.slug}/recommendations`} class="rounded-t-md border-b-2 border-transparent px-4 py-3 font-semibold text-gray-500 hover:border-evergreen-300 hover:text-evergreen-800">Recommendations</a>
        <a href={`/anime/${anime.id}/${anime.slug}/stats`} class="rounded-t-md border-b-2 border-transparent px-4 py-3 font-semibold text-gray-500 hover:border-evergreen-300 hover:text-evergreen-800">Statistics</a>
        {anime.trailer && <a href={`/anime/${anime.id}/${anime.slug}/trailers`} class="rounded-t-md border-b-2 border-transparent px-4 py-3 font-semibold text-gray-500 hover:border-evergreen-300 hover:text-evergreen-800">Trailers</a>}
      </nav>
          <h2 class="font-serif text-2xl font-bold text-evergreen-900">Synopsis</h2>
          <p class="mt-4 leading-relaxed text-gray-700 text-lg">
            {anime.description || 'No synopsis available.'}
          </p>
        </section>

        <section class="grid gap-8 md:grid-cols-2">
          <div class="rounded-xl border border-parchment-200 bg-white p-6 shadow-sm">
            <h3 class="mb-4 font-serif text-xl font-bold text-evergreen-900">Studios</h3>
            <ul class="space-y-2">
              {anime.studios.length > 0 ? anime.studios.map((s: string) => <li class="text-gray-600">{s}</li>) : <li class="text-gray-400 italic">Unknown</li>}
            </ul>
          </div>
          <div class="rounded-xl border border-parchment-200 bg-white p-6 shadow-sm">
            <h3 class="mb-4 font-serif text-xl font-bold text-evergreen-900">Producers</h3>
            <ul class="space-y-2">
              {anime.producers.length > 0 ? anime.producers.map((p: string) => <li class="text-gray-600">{p}</li>) : <li class="text-gray-400 italic">Unknown</li>}
            </ul>
          </div>
        </section>

        <section>
          <h2 class="mb-6 font-serif text-2xl font-bold text-evergreen-900">Related Works</h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {raw.relations?.edges?.map(({ node, relationType }: { node: any; relationType: string }) => (
              <div class="group relative rounded-lg border border-parchment-200 bg-white p-4 shadow-sm hover:shadow-md transition">
                <div class="flex gap-4">
                  <img src={node.coverImage.large} class="h-20 w-12 object-cover rounded" alt="" />
                  <div>
                    <p class="text-xs font-bold uppercase text-terracotta-600">{relationType}</p>
                    <h4 class="font-serif text-sm font-bold text-gray-900 line-clamp-1">{node.title.romaji}</h4>
                    <a href={`/anime/${node.id}/${node.slug}`} class="text-xs text-evergreen-700 hover:underline">View details →</a>
                  </div>
                </div>
              </div>
            )) || <p class="text-gray-500 italic">No related works found.</p>}
          </div>
        </section>
      </main>
    </div>
  </div>
</Layout>
