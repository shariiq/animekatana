---
import Layout from '../../../layouts/Layout.astro';
import { getAnime } from '../../../lib/anilist/client';

const { id } = Astro.params;
const animeId = parseInt(id!);

let data: Awaited<ReturnType<typeof getAnime>> | null = null;
try {
  data = await getAnime(animeId);
} catch {
}

if (!data) {
  return Astro.redirect('/404');
}

const { anime, raw } = data;
const displayTitle = anime.title.english || anime.title.romaji || anime.title.native || 'Untitled';
const relationSlug = (node: any) => node.slug ?? String(node.title?.english || node.title?.romaji || node.id).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<Layout title={`${displayTitle} — AnimeKatana`} description={anime.description || `Explore ${displayTitle} on AnimeKatana.`} image={anime.bannerImage || anime.coverImage.extraLarge}>
  <section class="relative isolate overflow-hidden bg-evergreen-950 text-white">
    {anime.bannerImage && <img src={anime.bannerImage} alt="" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-55" />}
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-evergreen-950 via-evergreen-950/85 to-evergreen-950/35"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-evergreen-950 via-transparent to-transparent"></div>
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-[12rem_1fr] lg:px-8 lg:py-20">
      <img src={anime.coverImage.extraLarge} alt={`Cover art for ${displayTitle}`} width="320" height="450" fetchpriority="high" class="w-40 self-end border border-white/20 shadow-xl sm:w-48" />
      <div class="self-end">
        <p class="eyebrow text-parchment-300">{[anime.format, anime.year, anime.status].filter(Boolean).join(' · ')}</p>
        <h1 class="mt-3 max-w-4xl font-serif text-4xl font-bold leading-tight tracking-tight sm:text-6xl">{displayTitle}</h1>
        {anime.title.native && <p class="mt-3 text-lg text-parchment-200">{anime.title.native}</p>}
        <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-parchment-100">
          {anime.score && <span>{anime.score}% community score</span>}
          {anime.episodes && <><span aria-hidden="true">•</span><span>{anime.episodes} episodes</span></>}
          {anime.duration && <><span aria-hidden="true">•</span><span>{anime.duration} min</span></>}
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`/anime/${anime.id}/${anime.slug}/watch/1`} class="btn-primary bg-parchment-100 text-evergreen-950 hover:bg-white">Start watching</a>
          {anime.trailer && <a href={`/anime/${anime.id}/${anime.slug}/trailers`} class="btn-secondary border-white/30 bg-transparent text-white hover:border-white hover:text-white">Watch trailer</a>}
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <nav aria-label="Anime guide" class="-mx-4 flex gap-1 overflow-x-auto border-b border-parchment-200 px-4 text-sm sm:mx-0 sm:px-0">
      <a href="#overview" aria-current="page" class="shrink-0 border-b-2 border-evergreen-900 px-4 py-4 font-semibold text-evergreen-900">Overview</a>
      <a href={`/anime/${anime.id}/${anime.slug}/characters`} class="shrink-0 border-b-2 border-transparent px-4 py-4 font-semibold text-gray-500 hover:text-evergreen-800">Characters</a>
      <a href={`/anime/${anime.id}/${anime.slug}/staff`} class="shrink-0 border-b-2 border-transparent px-4 py-4 font-semibold text-gray-500 hover:text-evergreen-800">Staff</a>
      <a href={`/anime/${anime.id}/${anime.slug}/recommendations`} class="shrink-0 border-b-2 border-transparent px-4 py-4 font-semibold text-gray-500 hover:text-evergreen-800">Recommendations</a>
      <a href={`/anime/${anime.id}/${anime.slug}/stats`} class="shrink-0 border-b-2 border-transparent px-4 py-4 font-semibold text-gray-500 hover:text-evergreen-800">Statistics</a>
    </nav>

    <div id="overview" class="grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <main class="space-y-14">
        <section>
          <p class="eyebrow">The guide</p>
          <h2 class="heading-2 mt-2">Synopsis</h2>
          <p class="body-lg mt-5 whitespace-pre-line">{anime.description || 'No synopsis is available for this title yet.'}</p>
        </section>

        {raw.relations?.edges?.length > 0 && <section>
          <p class="eyebrow">Continue exploring</p>
          <h2 class="heading-3 mt-2">Related works</h2>
          <div class="mt-6 divide-y divide-parchment-200 border-y border-parchment-200">
            {raw.relations.edges.map(({ node, relationType }: { node: any; relationType: string }) => (
              <a href={`/anime/${node.id}/${relationSlug(node)}`} class="group flex items-center gap-4 py-4">
                <img src={node.coverImage.large} loading="lazy" decoding="async" width="48" height="80" class="h-20 w-12 object-cover" alt="" />
                <div class="min-w-0 flex-1">
                  <p class="eyebrow text-[10px]">{relationType.replaceAll('_', ' ')}</p>
                  <h3 class="mt-1 line-clamp-2 font-serif font-bold group-hover:text-evergreen-800">{node.title.english || node.title.romaji}</h3>
                </div>
                <span aria-hidden="true" class="text-evergreen-700">→</span>
              </a>
            ))}
          </div>
        </section>}
      </main>

      <aside>
        <h2 class="heading-4">At a glance</h2>
        <dl class="mt-4 divide-y divide-parchment-200 border-y border-parchment-200 text-sm">
          {[
            ['Status', anime.status], ['Format', anime.format], ['Episodes', anime.episodes ?? 'Unknown'],
            ['Season', anime.season && anime.year ? `${anime.season} ${anime.year}` : anime.year ?? 'Unknown'],
            ['Duration', anime.duration ? `${anime.duration} min` : 'Unknown'], ['Studios', anime.studios.join(', ') || 'Unknown'],
          ].map(([label, value]) => <div class="grid grid-cols-[5rem_1fr] gap-3 py-3"><dt class="text-gray-500">{label}</dt><dd class="text-right font-medium text-gray-800">{value}</dd></div>)}
        </dl>
        <div class="mt-6 flex flex-wrap gap-2">{anime.genres.map((genre) => <a href={`/genre/${encodeURIComponent(genre)}`} class="rounded-full border border-parchment-300 px-3 py-1 text-xs text-gray-600 hover:border-evergreen-500 hover:text-evergreen-800">{genre}</a>)}</div>
      </aside>
    </div>
  </div>
</Layout>
