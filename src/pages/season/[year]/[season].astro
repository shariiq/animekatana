---
import AnimeSection from '../../../components/content/AnimeSection.astro';
import Layout from '../../../layouts/Layout.astro';
import { getCatalogue } from '../../../lib/anilist/client';
import { humanSeason } from '../../../lib/season';

const { year, season } = Astro.params;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const seasonName = (season || '').toUpperCase();

let data: Awaited<ReturnType<typeof getCatalogue>> | null = null;
let error: string | null = null;
try {
  data = await getCatalogue({ page, season: seasonName || undefined, year: year ? parseInt(year, 10) : undefined });
} catch (cause) {
  error = cause instanceof Error ? cause.message : 'The seasonal catalogue is unavailable.';
}

const pageHref = (p: number) => `?page=${p}`;
---

<Layout title={`${humanSeason(seasonName)} ${year} Anime — AnimeKatana`}>
  <section class="page-hero">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="eyebrow">{year}</p>
      <h1 class="page-hero-title mt-2">{humanSeason(seasonName)} {year}</h1>
      <p class="page-hero-description">The definitive guide to the most impactful series of the season.</p>
    </div>
  </section>

  <div class="page-shell">
    {error ? <div class="state-error" role="alert"><h2 class="heading-4 text-terracotta-900">The season could not be loaded.</h2><p class="mt-2">{error}</p></div>
      : data && data.items.length > 0 ? <AnimeSection title="Seasonal Lineup" eyebrow={`${data.items.length} titles on this page`} anime={data.items} />
      : <div class="state-empty"><h2 class="heading-3">No titles found for this season.</h2><p class="body-sm mt-2">Try a different season or explore the complete catalogue.</p><a href="/browse" class="btn-primary mt-6">Browse catalogue</a></div>}

    {data && (page > 1 || data.hasNext) && <nav class="pagination" aria-label="Season pages">
      <a href={pageHref(page - 1)} class:list={['pagination-link', page === 1 && 'pagination-link-disabled']} aria-disabled={page === 1 ? 'true' : undefined}>Previous</a>
      <span class="px-2 text-sm font-semibold text-gray-600">Page {page}</span>
      <a href={pageHref(page + 1)} class:list={['pagination-link', !data.hasNext && 'pagination-link-disabled']} aria-disabled={!data.hasNext ? 'true' : undefined}>Next</a>
    </nav>}
  </div>
</Layout>