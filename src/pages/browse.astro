---
import Layout from '../layouts/Layout.astro';
import AnimeSection from '../components/content/AnimeSection.astro';
import { getCatalogue } from '../lib/anilist/client';

const { searchParams } = Astro.url;
const page = parseInt(searchParams.get('page') ?? '1');
const genre = searchParams.get('genre') || null;
const format = searchParams.get('format') || null;
const status = searchParams.get('status') || null;
const season = searchParams.get('season') || null;
const year = searchParams.get('year') ? parseInt(searchParams.get('year')!) : null;
const sort = searchParams.get('sort')?.split(',') || ['POPULARITY_DESC'];

let data: Awaited<ReturnType<typeof getCatalogue>> | null = null;
let error: string | null = null;
try {
  data = await getCatalogue({ page, genre: genre || undefined, format: format || undefined, status: status || undefined, season: season || undefined, year: year || undefined, sort });
} catch (cause) {
  error = cause instanceof Error ? cause.message : 'The catalogue service is temporarily unavailable.';
}

const activeFilters = [
  { label: 'Genre', value: genre, href: genre ? `/browse?format=${format || ''}&status=${status || ''}&season=${season || ''}&year=${year || ''}&sort=${sort.join(',')}` : null },
  { label: 'Format', value: format, href: format ? `/browse?genre=${genre || ''}&status=${status || ''}&season=${season || ''}&year=${year || ''}&sort=${sort.join(',')}` : null },
  { label: 'Status', value: status, href: status ? `/browse?genre=${genre || ''}&format=${format || ''}&season=${season || ''}&year=${year || ''}&sort=${sort.join(',')}` : null },
].filter(f => f.value);
---

<Layout title="Browse Anime — AnimeKatana">
  <section class="border-b border-parchment-200 bg-parchment-100 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="font-serif text-4xl font-bold text-evergreen-950 sm:text-5xl">Catalogue</h1>
      <p class="mt-4 max-w-2xl text-lg text-gray-700">Refine your search through our exhaustive library of anime, from seasonal hits to forgotten classics.</p>

      <div class="mt-8 flex flex-wrap gap-3">
        {activeFilters.map(filter => (
          <a href={filter.href} class="inline-flex items-center gap-2 rounded-full bg-evergreen-100 px-3 py-1 text-xs font-bold text-evergreen-800 hover:bg-evergreen-200">
            {filter.label}: {filter.value}
            <span class="ml-1 text-evergreen-400">×</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[280px_1fr]">
      <aside class="space-y-8">
        <div>
          <h3 class="mb-4 font-semibold text-gray-900">Format</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            {['TV', 'MOVIE', 'OVA', 'ONA', 'SPECIAL'].map(f => (
              <li>
                <a href={`?format=${f}&status=${status || ''}&genre=${genre || ''}`} class={`block py-1 ${format === f ? 'font-bold text-evergreen-800' : 'hover:text-evergreen-700'}`}>{f}</a>
              </li>
            ))}
          </ul>
        </div >
        <div>
          <h3 class="mb-4 font-semibold text-gray-900">Status</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            {['FINISHED', 'RELEASING', 'NOT_YET_RELEASED'].map(s => (
              <li>
                <a href={`?status=${s}&format=${format || ''}&genre=${genre || ''}`} class={`block py-1 ${status === s ? 'font-bold text-evergreen-800' : 'hover:text-evergreen-700'}`}>{s}</a>
              </li>
            ))}
          </ul>
        </div >
      </aside>

      <main>
        {error ? (
          <div class="rounded-lg border border-terracotta-200 bg-terracotta-50 p-6 text-terracotta-800">{error}</div>
        ) : data && data.items.length > 0 ? (
          <AnimeSection title="Results" anime={data.items} />
        ) : (
          <div class="py-24 text-center text-gray-600">No anime match these filters.</div>
        )}

        {data?.hasNext && (
          <div class="mt-12 flex justify-center gap-4">
            <a href={`?page=${page - 1}&genre=${genre || ''}&format=${format || ''}&status=${status || ''}`} class={`rounded-md border border-gray-300 bg-white px-6 py-2 text-sm font-medium ${page === 1 ? 'pointer-events-none opacity-50' : 'hover:bg-gray-50'}`}>Previous</a>
            <a href={`?page=${page + 1}&genre=${genre || ''}&format=${format || ''}&status=${status || ''}`} class="rounded-md border border-gray-300 bg-white px-6 py-2 text-sm font-medium hover:bg-gray-50">Next Page</a>
          </div>
        )}
      </main>
    </div>
  </div>
</Layout>
