---
import Layout from "../layouts/Layout.astro";
import AnimeSection from "../components/content/AnimeSection.astro";
import SearchBar from "../components/islands/SearchBar";
import { getCatalogue } from "../lib/anilist/client";
const { searchParams } = Astro.url;
const page = parseInt(searchParams.get("page") ?? "1");
const query = searchParams.get("q") ?? "";
let data: Awaited<ReturnType<typeof getCatalogue>> | null = null;
let error: string | null = null;
try {
	data = await getCatalogue({ page, search: query });
} catch (cause) {
	error =
		cause instanceof Error
			? cause.message
			: "The search service is temporarily unavailable.";
}
---
<Layout title={query ? `Searching for "${query}" — AnimeKatana` : 'Search Anime — AnimeKatana'}><section class="page-band"><div class="page-shell"><p class="eyebrow">Find your next watch</p><h1 class="display-title mt-2 text-4xl sm:text-5xl">Search the catalogue</h1><p class="mt-3 max-w-2xl text-parchment-700">Search by title, then open a guide for the details behind the show.</p><div class="mt-7 max-w-2xl"><SearchBar initialQuery={query} /></div></div></section><div class="page-shell py-10">{query && <p class="mb-6 text-sm text-parchment-700">Showing results for <strong class="text-evergreen-950">“{query}”</strong></p>}{error ? <section class="rounded-lg border border-terracotta-200 bg-terracotta-50 p-6"><h2 class="display-title text-2xl text-terracotta-900">Search failed.</h2><p class="mt-2 text-terracotta-800">{error}</p></section> : data && data.items.length > 0 ? <AnimeSection title="Matches" anime={data.items} /> : <div class="quiet-empty py-20"><h2 class="display-title text-2xl">No matches found.</h2><p class="mx-auto mt-2 max-w-md">Try a different keyword or browse the full catalogue.</p><a href="/browse" class="button-primary mt-6">Explore catalogue</a></div>}{data?.hasNext && <div class="mt-10 flex justify-center gap-3"><a href={`?q=${encodeURIComponent(query)}&page=${page - 1}`} class={`button-secondary ${page === 1 ? 'pointer-events-none opacity-40' : ''}`}>Previous</a><a href={`?q=${encodeURIComponent(query)}&page=${page + 1}`} class="button-secondary">Next page</a></div>}</div></Layout>
