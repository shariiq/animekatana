---
import AnimeSection from '../components/content/AnimeSection.astro';
import Layout from '../layouts/Layout.astro';
import { getCatalogue } from '../lib/anilist/client';

const { searchParams } = Astro.url;
const page = Math.max(1, parseInt(searchParams.get('page') ?? '1', 10) || 1);
const query = searchParams.get('q') ?? '';

let data: Awaited<ReturnType<typeof getCatalogue>> | null = null;
let error: string | null = null;
try {
  data = await getCatalogue({ page, search: query });
} catch (cause) {
  error = cause instanceof Error ? cause.message : 'The search service is temporarily unavailable.';
}
---

<Layout title={query ? `Results for "${query}" — AnimeKatana` : 'Search Anime — AnimeKatana'}>
  <section class="page-hero">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Anime search</p>
          <h1 class="page-hero-title mt-2">{query ? `Results for "${query}"` : 'Search'}</h1>
        </div>
        <a href="/browse" class="btn-secondary self-start">Browse by filter</a>
      </div>
    </div>
  </section>

  <div class="page-shell">
    {error ? <div class="state-error" role="alert"><h2 class="heading-4 text-terracotta-900">Search failed.</h2><p class="mt-2">{error}</p></div>
      : data && data.items.length > 0 ? <AnimeSection title="Matches" eyebrow={`${data.items.length} titles on this page`} anime={data.items} />
      : <div class="state-empty">
          <span class="mb-4 block text-5xl" aria-hidden="true">🔍</span>
          <h2 class="heading-3">{query ? 'Nothing matches your terms.' : 'Enter a search to begin.'}</h2>
          <p class="body-sm mt-2">{query ? 'Try a different keyword or browse the catalogue directly.' : 'Search by title, theme, or character name.'}</p>
          <a href="/browse" class="btn-primary mt-6">Explore catalogue</a>
        </div>}

    {data && (page > 1 || data.hasNext) && <nav class="pagination" aria-label="Search pages">
      <a href={`?q=${encodeURIComponent(query)}&page=${page - 1}`} class:list={['pagination-link', page === 1 && 'pagination-link-disabled']} aria-disabled={page === 1 ? 'true' : undefined}>Previous</a>
      <span class="px-2 text-sm font-semibold text-gray-600">Page {page}</span>
      <a href={`?q=${encodeURIComponent(query)}&page=${page + 1}`} class:list={['pagination-link', !data.hasNext && 'pagination-link-disabled']} aria-disabled={!data.hasNext ? 'true' : undefined}>Next</a>
    </nav>}
  </div>
</Layout>