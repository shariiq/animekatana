---
import AnimeSection from '../../components/content/AnimeSection.astro';
import Layout from '../../layouts/Layout.astro';
import { getCatalogue } from '../../lib/anilist/client';

const genre = Astro.params.genre ?? 'Anime';
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
let data: Awaited<ReturnType<typeof getCatalogue>> | null = null;
let error: string | null = null;
try { data = await getCatalogue({ page, genre }); }
catch (cause) { error = cause instanceof Error ? cause.message : 'The genre catalogue is unavailable.'; }
---

<Layout title={`${genre} Anime — AnimeKatana`}>
  <section class="page-hero"><div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="eyebrow">Genre guide</p><h1 class="page-hero-title mt-2">{genre}</h1>
    <p class="page-hero-description">Definitive classics and new discoveries from across {genre.toLowerCase()} anime.</p>
  </div></section>
  <div class="page-shell">
    {error ? <div class="state-error" role="alert"><h2 class="heading-4 text-terracotta-900">This collection could not be loaded.</h2><p class="mt-2">{error}</p></div>
      : data && data.items.length > 0 ? <AnimeSection title={`${genre} Collection`} eyebrow={`${data.items.length} titles on this page`} anime={data.items} />
      : <div class="state-empty"><h2 class="heading-3">No {genre} titles found.</h2><a href="/browse" class="btn-primary mt-6">Browse all anime</a></div>}
    {data && (page > 1 || data.hasNext) && <nav class="pagination" aria-label="Genre pages">
      <a href={`?page=${page - 1}`} class:list={['pagination-link', page === 1 && 'pagination-link-disabled']} aria-disabled={page === 1 ? 'true' : undefined}>Previous</a><span class="px-2 text-sm font-semibold text-gray-600">Page {page}</span><a href={`?page=${page + 1}`} class:list={['pagination-link', !data.hasNext && 'pagination-link-disabled']} aria-disabled={!data.hasNext ? 'true' : undefined}>Next</a>
    </nav>}
  </div>
</Layout>