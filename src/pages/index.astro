---
import AnimeSection from "../components/content/AnimeSection.astro";
import SearchBar from "../components/islands/SearchBar";
import Layout from "../layouts/Layout.astro";
import { getHome } from "../lib/anilist/client";
import { currentSeason, humanSeason } from "../lib/season";
const now = currentSeason();
let data: Awaited<ReturnType<typeof getHome>> | null = null;
let error: string | null = null;
try {
	data = await getHome(now.year, now.season);
} catch (cause) {
	error =
		cause instanceof Error
			? cause.message
			: "The catalogue could not be loaded.";
}
const feature = data?.trending.items[0];
const featureTitle =
	feature?.title.english ||
	feature?.title.romaji ||
	feature?.title.native ||
	"Your next story is waiting";
---
<Layout title="AnimeKatana — Discover your next story"><section class="border-b border-parchment-200 bg-parchment-100"><div class="page-shell grid gap-8 py-12 sm:py-16 lg:grid-cols-[1.05fr_.95fr] lg:gap-14 lg:py-20"><div class="flex flex-col justify-center"><p class="eyebrow mb-4">Editorial anime discovery</p><h1 class="display-title max-w-3xl text-5xl leading-[.98] sm:text-6xl">Find the story that stays with you.</h1><p class="mt-6 max-w-xl text-base leading-relaxed text-parchment-700 sm:text-lg">A considered catalogue for every mood, season, and late-night episode. Deep AniList context, then playback only when you decide to press play.</p><div class="mt-7 max-w-xl"><SearchBar /></div><div class="mt-6 flex flex-wrap gap-x-5 gap-y-3 text-sm"><a class="ink-link" href="/season">Explore {humanSeason(now.season)} {now.year} →</a><a class="ink-link" href="/schedule">See what airs next →</a></div></div><div class="relative aspect-[4/5] overflow-hidden rounded-lg bg-evergreen-950 shadow-lift sm:aspect-[5/4] lg:aspect-auto lg:min-h-[30rem]">{feature ? <><img src={feature.bannerImage || feature.coverImage.extraLarge} alt="" width="1200" height="800" class="absolute inset-0 h-full w-full object-cover opacity-70" fetchpriority="high" /><div class="absolute inset-0 bg-gradient-to-t from-evergreen-950 via-evergreen-950/45 to-transparent"></div><div class="absolute inset-x-0 bottom-0 p-6 text-white sm:p-8"><p class="text-xs font-bold uppercase tracking-[.18em] text-parchment-300">Currently trending</p><h2 class="mt-2 font-serif text-3xl font-bold leading-tight sm:text-4xl">{featureTitle}</h2><div class="mt-4 flex flex-wrap gap-3 text-sm text-white/80"><span>{feature.format}</span><span aria-hidden="true">•</span><span>{feature.score ?? '—'}% community score</span>{feature.episodes && <><span aria-hidden="true">•</span><span>{feature.episodes} episodes</span></>}</div><a href={`/anime/${feature.id}/${feature.slug}`} class="button-secondary mt-6 !border-0 !bg-parchment-100 !text-evergreen-950 hover:!bg-white">Read the full guide</a></div></> : <div class="flex h-full items-center justify-center p-10 text-center text-parchment-100">A new story is nearly ready.</div>}</div></div></section><div class="page-shell">{error ? <section class="my-10 rounded-lg border border-terracotta-200 bg-terracotta-50 p-6"><h2 class="display-title text-2xl text-terracotta-900">The catalogue needs a moment.</h2><p class="mt-2 text-terracotta-800">{error}</p><a href={Astro.url.pathname} class="ink-link mt-4 inline-block">Try again</a></section> : data && <><AnimeSection title="In the conversation" eyebrow="Trending now" description="The titles anime fans are reaching for today." anime={data.trending.items} viewAllHref="/browse?sort=TRENDING_DESC" /><AnimeSection title={`${humanSeason(now.season)} ${now.year}, considered`} eyebrow="This season" description="The defining shows of the current broadcast season." anime={data.seasonal.items} viewAllHref={`/season/${now.year}/${now.season.toLowerCase()}`} /><AnimeSection title="Enduring favourites" eyebrow="Popular" description="Beloved series with the reach to become your next obsession." anime={data.popular.items} viewAllHref="/rankings" ranked /><AnimeSection title="On the horizon" eyebrow="Upcoming" description="Stories worth putting on your calendar." anime={data.upcoming.items} viewAllHref="/browse?status=NOT_YET_RELEASED" /></>}</div></Layout>
