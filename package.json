{
	"name": "animekatana",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev --host 0.0.0.0",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"test": "vitest run",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome check .",
		"postinstall": "git config core.hooksPath .githooks || true"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/vercel": "^11.0.10",
		"@qwik.dev/astro": "^1.2.0",
		"@qwik.dev/core": "^2.0.0-beta.43",
		"astro": "^7.3.2",
		"hls.js": "^1.7.3",
		"typescript": "^5.9.3",
		"zod": "^4.6.5"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.5.1",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.11"
	},
	"description": "A warm editorial anime discovery and watch destination"
}
